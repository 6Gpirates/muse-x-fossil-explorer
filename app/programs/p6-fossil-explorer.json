{
  "id": "p6-fossil-explorer",
  "version": "0.1.0",
  "_note": "화석으로 알아보는 생물 탐구. 신규 블록 draw.habitat / dating.sim / taxonomy.ai / card.collect 필요. 번호·index 위치는 총괄자 확정 대상.",
  "title": "화석으로 알아보는 생물 탐구",
  "subtitle": "화석 채집 → 환경·연대 뽑기 → 조사 → 상상해 그리기 → AI 실사화 → AI 분류 → 수집 카드",
  "gradeBand": "middle",
  "hall": "자연사관 · 화석 전시",
  "aiType": "image",
  "estimatedMinutes": 210,
  "groupMode": "solo-or-pair",
  "sessions": [
    {
      "id": "s1", "no": 1, "title": "화석을 채집하다", "tagline": "과학관에서 내 화석을 고른다",
      "steps": [
        { "id": "s1-01", "phase": "collect", "title": "내 화석 사진",
          "blocks": [
            { "type": "text", "tone": "plain", "body": "국립중앙과학관을 돌아보며 마음에 드는 화석을 사진으로 찍어 올리세요." },
            { "type": "capture.photo", "id": "fossil-photo", "label": "내 화석", "groups": [{ "key": "fossil", "label": "내 화석", "min": 1 }] }
          ],
          "advance": { "requires": ["fossil-photo"] } }
      ]
    },
    {
      "id": "s2", "no": 2, "title": "이 화석이 만들어진 연대와 살았던 환경은?", "tagline": "무작위 환경 배정 + 방사성 연대 측정",
      "steps": [
        { "id": "s2-01", "phase": "draw", "title": "서식 환경 뽑기",
          "blocks": [
            { "type": "text", "tone": "plain", "body": "무작위로 배정받은 환경과 시대에 이 생물이 적응해 살았다고 상상합니다." },
            { "type": "draw.habitat", "id": "draw-habitat", "label": "서식 환경 뽑기", "poolRef": "habitats" }
          ],
          "advance": { "requires": ["draw-habitat"] } },
        { "id": "s2-02", "phase": "dating", "title": "방사성 연대 측정",
          "blocks": [
            { "type": "dating.sim", "id": "dating-sim", "label": "방사성 연대 측정", "problemsRef": "datingProblems", "tableRef": "halfLifeTable" }
          ],
          "advance": { "requires": ["dating-sim"] } }
      ]
    },
    {
      "id": "s3", "no": 3, "title": "환경을 조사하다", "tagline": "이 환경 생물들의 공통점",
      "steps": [
        { "id": "s3-01", "phase": "research", "title": "환경과 생물 조사",
          "blocks": [
            { "type": "text", "tone": "plain", "body": "믿을 수 있는 자료로 내가 뽑은 서식 환경을 조사하고, 그 환경에 사는 생물들의 공통 속성을 정리하세요. (환경 조사 글은 한글 200자 이상)" },
            { "type": "input.long", "id": "env-research", "label": "이 서식 환경은 어떤 곳인가 (기후·지형·특징)", "min": 200 },
            { "type": "input.table", "id": "common-traits", "label": "이 환경 생물들의 공통 속성",
              "rows": [
                { "key": "body", "label": "몸의 구조" }, { "key": "food", "label": "먹이·에너지" },
                { "key": "move", "label": "이동 방법" }, { "key": "temp", "label": "체온·수분 유지" },
                { "key": "repro", "label": "번식·생존 전략" }
              ] }
          ],
          "advance": { "requires": ["env-research", "common-traits"] } },
        { "id": "s3-02", "phase": "research", "title": "내 서식 환경 퀴즈",
          "blocks": [
            { "type": "text", "tone": "plain", "body": "내가 뽑은 서식 환경에 대한 퀴즈입니다. 문제는 뽑은 환경과 내가 적은 조사 내용에 따라 그때그때 다르게 나옵니다." },
            { "type": "quiz", "id": "mid-quiz", "label": "내 서식 환경 퀴즈", "questions": [{"key":"m1","q":"사막에 사는 동물에게 가장 흔히 나타나는 적응은?","choices":["몸에 물을 저장하거나 물 손실을 줄이는 구조","넓고 얇은 잎","두꺼운 지방층과 흰 털","발광 기관"],"answer":0,"why":"사막은 극도로 건조해 수분 보존이 생존의 핵심입니다."},{"key":"m2","q":"같은 서식 환경의 계통이 다른 생물들이 비슷한 생김새를 갖게 되는 현상은?","choices":["수렴 진화","돌연변이","공생","먹이 사슬"],"answer":0,"why":"비슷한 환경 압력이 계통이 달라도 유사한 형질을 만듭니다(수렴 진화)."}] }
          ],
          "advance": { "requires": ["mid-quiz"] } },
        { "id": "s3-03", "phase": "research", "title": "내 지질 시대 조사",
          "blocks": [
            { "type": "text", "tone": "plain", "body": "방사성 연대 측정으로 나온 '내 지질 시대'를 조사해 정리하세요. 아래 두 가지를 꼭 담습니다.\n· 그 시대의 환경 — 기후, 바다와 육지의 모습, 빙하 여부\n· 그 시대에 살던 동물들의 특징 — 대표 동물과 그들의 생김새·생활\n(한글 200자 내외)" },
            { "type": "input.long", "id": "era-research", "label": "내 지질 시대는 어떤 시대였나 (그때의 환경 + 그때 살던 동물의 특징)", "min": 150 }
          ],
          "advance": { "requires": ["era-research"] } }
      ]
    },
    {
      "id": "s4", "no": 4, "title": "상상의 동물을 그리다", "tagline": "공통 속성을 반영한 그림",
      "steps": [
        { "id": "s4-01", "phase": "create", "title": "생물 그리기",
          "blocks": [
            { "type": "text", "tone": "plain", "body": "조사한 공통 속성이 드러나도록 이 환경·시대에 살 법한 생물을 그리세요. 반드시 색을 칠해 완성합니다." },
            { "type": "capture.sketch", "id": "sketch", "label": "내 생물 그리기", "ratio": "4:3", "minStrokes": 12,
              "guide": "몸의 구조 / 먹이 / 이동 / 체온·수분 / 번식 특징이 드러나게, 채색까지 완성" },
            { "type": "input.short", "id": "bio-name", "label": "생물 이름" }
          ],
          "advance": { "requires": ["sketch", "bio-name"] } },
        { "id": "s4-02", "phase": "create", "title": "생물 설명",
          "blocks": [
            { "type": "text", "tone": "plain", "body": "이 생물을 자세히 설명하세요. 아래 다섯 가지가 모두 드러나게 씁니다.\n· 몸의 구조 (크기·형태·특징)\n· 먹이와 에너지를 얻는 방법\n· 이동 방법\n· 체온·수분을 유지하는 방법\n· 번식·생존 전략\n(한글 200자 이상 써야 다음으로 넘어갈 수 있습니다.)\n\n★ 이 설명은 이 수업에서 가장 중요한 활동입니다. 내가 부여받은 서식 환경과 지질 시대에 이 생물이 얼마나 잘 적응했는지를 AI가 '적응 진화 점수'(100점)로 매기며, 이 점수가 마지막 카드 등급을 가장 크게 좌우합니다. 환경·시대의 특징과 생물의 생김새·습성을 촘촘히 연결해 쓰세요." },
            { "type": "input.long", "id": "bio-desc", "label": "생물 상세 설명", "min": 200 }
          ],
          "advance": { "requires": ["bio-desc"] } }
      ]
    },
    {
      "id": "s5", "no": 5, "title": "AI로 되살리다", "tagline": "내 생물 → 극실사 사진",
      "steps": [
        { "id": "s5-01", "phase": "ai", "title": "AI 이미지 생성",
          "blocks": [
            { "type": "text", "tone": "plain", "body": "지금까지 만든 생물 설명·서식 환경·생존 연대를 바탕으로 극실사 사진을 생성합니다. 교사가 지정한 프롬프트가 자동으로 사용됩니다." },
            { "type": "ai.prompt", "id": "realism-prompt", "label": "생성에 쓰이는 정보 (자동)", "join": "\n",
              "fields": [
                { "key": "desc", "label": "생물 설명" },
                { "key": "habitat", "label": "서식 환경" },
                { "key": "era", "label": "생존 연대·적응 특징" }
              ] },
            { "type": "ai.launch", "id": "realism-launch", "label": "AI 이미지 생성", "promptRef": "realism-prompt", "url": "", "tool": "(교사 지정)" }
          ],
          "advance": { "requires": [] } },
        { "id": "s5-02", "phase": "ai", "title": "결과 이미지",
          "blocks": [
            { "type": "ai.collect", "id": "ai-image", "label": "완성 이미지 업로드", "accept": ["file", "url"], "promptRef": "realism-prompt" },
            { "type": "compare", "id": "sketch-vs-ai", "label": "결과 확인 · 다시 생성",
              "left": { "label": "손그림", "ref": "sketch" }, "right": { "label": "AI 실사", "ref": "ai-image" } }
          ],
          "advance": { "requires": ["ai-image"] } }
      ]
    },
    {
      "id": "s6", "no": 6, "title": "이 생물은 어떻게 분류될까?", "tagline": "AI 분류학 연구소 — 린네 7단계 분류와 학명",
      "steps": [
        { "id": "s6-01", "phase": "ai", "title": "AI 분류 분석",
          "blocks": [
            { "type": "text", "tone": "plain", "body": "완성된 AI 실사 사진을 분류학자 AI에게 보냅니다.\n· 계·문·강·목·과 — 생물학·고생물학계에 실제로 존재하는(학술적으로 등재된) 정통 분류군만 판별합니다.\n· 속·종 — 이번 탐사에서 처음 발견된 신종이므로 라틴어 이명법 규칙에 따라 새로 이름을 지어 줍니다.\n분석이 끝나면 AI가 지어 준 국명을 그대로 쓸지 직접 정할 수 있고, 라틴어 학명과 7단계 분류는 마지막 카드에 함께 실립니다." },
            { "type": "taxonomy.ai", "id": "taxonomy", "label": "AI 분류 분석", "imageRef": "ai-image", "nameRef": "bio-name" }
          ],
          "advance": { "requires": ["taxonomy"] } }
      ]
    },
    {
      "id": "s7", "no": 7, "title": "카드를 완성하고 나누다", "tagline": "내 카드 완성 + 친구 카드 모으기",
      "steps": [
        { "id": "s7-01", "phase": "collect", "title": "내 카드 만들기",
          "blocks": [
            { "type": "text", "tone": "plain", "body": "완성된 그림과 AI 이미지를 바탕으로 카드를 완성합니다. 이름과 서식지는 앞에서 정한 대로 들어가고, 타입·특수 능력·약점은 AI가 그림을 보고 정해 줍니다. 만들면 카드 결과가 바로 나옵니다." },
            { "type": "input.table", "id": "card-info", "label": "카드에 넣을 정보",
              "rows": [
                { "key": "name", "label": "이름" }, { "key": "type", "label": "타입" },
                { "key": "habitat", "label": "서식지" }, { "key": "ability", "label": "특수 능력" },
                { "key": "weakness", "label": "약점" }
              ] },
            { "type": "card.collect", "id": "card-collect", "label": "내 생물 카드",
              "imageRef": "ai-image", "infoRef": "card-info", "quizRef": "final-quiz", "rarityRef": "rarity",
              "taxonomyRef": "taxonomy",
              "quizCount": 5,
              "_signalNote": "bio-desc/quizscore = 적응 진화 점수(4-2, 100점). 이 수업의 핵심 평가라 가장 큰 가중치.",
              "signals": [
                { "ref": "bio-desc", "kind": "quizscore", "weight": 28 },
                { "ref": "sketch", "kind": "strokes", "weight": 8, "full": 36 },
                { "ref": "bio-desc", "kind": "textlen", "weight": 6, "full": 300 },
                { "ref": "card-info", "kind": "fields", "weight": 8 },
                { "ref": "common-traits", "kind": "rows", "weight": 6 },
                { "ref": "env-research", "kind": "quizscore", "weight": 7 },
                { "ref": "sketch", "kind": "quizscore", "weight": 7 }
              ] }
          ],
          "advance": { "requires": ["card-info", "card-collect"] } },
        { "id": "s7-02", "phase": "quiz", "title": "친구 카드 도감",
          "blocks": [
            { "type": "text", "tone": "plain", "body": "친구들이 만든 카드를 살펴보고, 각 카드에 대한 과학 퀴즈에서 3개 이상 맞히면 그 카드를 내 도감북에 넣을 수 있습니다." },
            { "type": "quiz", "id": "final-quiz", "label": "친구 카드 도감", "questions": [{"key":"f1","q":"자리표시자","choices":["a","b","c","d"],"answer":0,"why":"카드 도감에서 카드별로 생성됩니다."}] },
            { "type": "submit", "id": "final-submit", "label": "최종 제출" }
          ],
          "advance": { "requires": [] } }
      ]
    }
  ],
  "deliverable": {
    "collect": ["fossil-photo", "draw-habitat", "dating-sim", "env-research", "common-traits", "mid-quiz", "era-research", "sketch", "bio-name", "bio-desc", "card-info", "ai-image", "sketch-vs-ai", "taxonomy", "final-quiz", "card-collect"],
    "export": ["pdf", "zip", "csv"]
  }
}
